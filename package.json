{
  "name": "deadline-day",
  "version": "0.1.0",
  "private": true,
  "description": "Deadline Day: a multiplayer football auction and season simulator (unofficial fan game).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w @deadline-day/server\" \"npm run dev -w @deadline-day/web\"",
    "build": "npm run build -w @deadline-day/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "seed": "npm run seed -w @deadline-day/scripts --",
    "data:validate": "npm run data:validate -w @deadline-day/scripts --",
    "db:generate": "npm run db:generate -w @deadline-day/server",
    "db:migrate": "npm run db:migrate -w @deadline-day/scripts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
