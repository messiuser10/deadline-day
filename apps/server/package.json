{
  "name": "@deadline-day/server",
  "version": "0.1.0",
  "private": true,
  "description": "Deadline Day API and realtime server (Fastify, Socket.IO, Drizzle).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./data": "./src/data/load.ts",
    "./config": "./src/config.ts",
    "./paths": "./src/paths.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "dependencies": {
    "@deadline-day/engine": "*",
    "@deadline-day/protocol": "*",
    "@fastify/cookie": "^11.1.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.4"
  }
}
