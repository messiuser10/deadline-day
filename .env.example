# Copy to .env and adjust. Never commit the real .env.

# HTTP port for the API server (the web dev server proxies /api and /socket.io to it).
PORT=3001

# Database. SQLite file path as file:<path> (relative to the repo root), or a postgres:// URL.
DATABASE_URL=file:./var/deadline-day.sqlite

# A user who registers with this username becomes admin.
ADMIN_USERNAME=admin

# Secret for signing session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Origin of the web app (used for CORS in development).
WEB_ORIGIN=http://localhost:5173
